# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Connect your Supabase project for persistent cloud backend)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# OWNER / ADMIN PROVISIONING KEY (used on /admin/signup to verify initial admin setup)
VITE_ADMIN_INVITE_CODE="EMAN_PORTFOLIO_ADMIN_2026"

